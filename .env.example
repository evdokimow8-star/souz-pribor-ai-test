# Скопируйте в .env. Реальный ключ никогда не добавляйте в Git.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Выберите модель, поддерживающую structured outputs / json_schema.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
# Только для уже настроенного шлюза владельца; локально обычно не требуется.
LLM_GATEWAY_TOKEN=
